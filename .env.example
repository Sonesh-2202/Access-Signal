# Copy to .env and adjust. Every value has a working default for local development:
# with no .env at all you get SQLite, local disk uploads and keyword rules (no cloud calls).
# Never commit .env. On a host, set these as platform environment variables instead.

# ---------------------------------------------------------------- runtime
# development | production. Production refuses the default SECRET_KEY and skips create_all.
# ENVIRONMENT=development

# ---------------------------------------------------------------- database
# Unset: SQLite at backend/accesssignal.db.
# docker-compose sets the PostGIS container:
#   DATABASE_URL=postgresql+psycopg://accesssignal:accesssignal@localhost:5432/accesssignal
# Supabase (hosted demo): Connect > Session pooler. postgresql:// is rewritten to psycopg 3 and TLS is enforced.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# AUTO_CREATE_TABLES=true      # false when Alembic owns the schema (hosted)

# ---------------------------------------------------------------- auth
# Generate a real key for anything beyond a laptop demo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------- AI (cloud only)
# Tiers, tried in this order:
#   1. A bring-your-own-key provider sent by the browser (X-AI-Provider / X-AI-Key), if any
#   2. Server keys below, in AI_CLOUD_ORDER, for each provider that has a key set
#   3. Keyword rules, labelled "Keyword rules, AI offline". No network calls.
#   cloud   use the server keys that are set
#   none    keyword rules only, even when keys are set
AI_PROVIDER=cloud
AI_FALLBACK_ENABLED=true
AI_TIMEOUT_SECONDS=45

# Cloud tiers. Free tiers; see docs/DEPLOYMENT.md for current quotas.
# AI_CLOUD_ORDER=gemini,groq,nebius
# Google AI Studio: https://aistudio.google.com/apikey  (text + photos)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GroqCloud: https://console.groq.com/keys  (text only)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Nebius Token Factory (optional, for existing credits; never the default)
# NEBIUS_API_KEY=
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# NEBIUS_VISION=false

# Bring-your-own-key: browsers may send X-AI-Provider / X-AI-Key per request. Works for
# classification and for the assistant. Keys are never stored or logged.
# BYOK_ENABLED=true

# Per-IP limits. Classification and the assistant have separate budgets.
# CLASSIFY_RATE_LIMIT_PER_MINUTE=20
# CLASSIFY_MAX_BODY_BYTES=16384

# ---------------------------------------------------------------- chat assistant (read-only)
# The assistant reads public report, place and route data and answers in text. It can't
# file, change or verify anything. Conversations are sent to the cloud provider that answers.
# CHAT_RATE_LIMIT_PER_MINUTE=10     # questions per minute per IP, shown to users when reached
# CHAT_MAX_MESSAGES=12              # earlier turns beyond this are dropped
# CHAT_MAX_INPUT_CHARS=4000         # per message
# CHAT_MAX_CONTEXT_CHARS=6000       # report, place or route data given to the model
# CHAT_MAX_TOKENS=500               # answer length cap
# CHAT_TEMPERATURE=0.2
# CHAT_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------- file storage
# local (default): files under UPLOAD_DIR. supabase: private Supabase Storage bucket.
# STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
# SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: server-side only. Never put it in a VITE_ variable.
# SUPABASE_SERVICE_KEY=
# SUPABASE_STORAGE_BUCKET=evidence
# SIGNED_URL_TTL_SECONDS=300

# ---------------------------------------------------------------- CORS and proxies
# Origins only (scheme://host[:port]). Add the GitHub Pages origin when the frontend is hosted there.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:3000
# Reverse proxies in front of the API that append to X-Forwarded-For (0 = use the socket address).
# TRUSTED_PROXY_HOPS=0

DEMO_MODE=true
# DEMO_PASSWORD=Signal-demo-2026

# ---------------------------------------------------------------- frontend (read by Vite at build time)
# Everything here ends up in public JavaScript. Never put a secret in a VITE_ variable.
# API origin when the frontend is served elsewhere (GitHub Pages). Empty = same origin (/api via proxy).
# VITE_API_BASE=https://accesssignal-api.onrender.com
# Sub-path the site is served from, e.g. /Access-Signal/ on a GitHub project page.
# VITE_BASE_PATH=/
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE=raster          # plain OSM raster tiles, no 3D buildings
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_API_PROXY=http://localhost:8000
